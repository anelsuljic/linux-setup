#!/bin/sh
# Compositor of the sddm greeter, installed by setup-sddm.sh.

# Same graphics preference as the user session: the amd igpu drives the panel
# and the nvidia dgpu stays asleep. The cards are resolved by driver name
# because their numbers are not stable across boots, and a wrong choice here
# means no login screen at all.
amd=""
other=""
for dev in /dev/dri/card*; do
    [ -e "$dev" ] || continue
    node=${dev##*/}
    driver=$(sed -n 's/^DRIVER=//p' "/sys/class/drm/$node/device/uevent" 2>/dev/null)
    if [ "$driver" = "amdgpu" ]; then
        amd="$amd $dev"
    else
        other="$other $dev"
    fi
done

devices=""
for dev in $amd $other; do
    devices="${devices:+$devices:}$dev"
done
[ -n "$devices" ] && export AQ_DRM_DEVICES="$devices"

# Cursor of hyprland itself. The greeter sets its own one through sddm.
export XCURSOR_THEME=Bibata-Modern-Ice
export XCURSOR_SIZE=32

# start-hyprland stays in the foreground watching over hyprland, so sddm can
# track and stop the process it started. The arguments after -- go to hyprland.
exec start-hyprland -- -c /etc/sddm/hyprland-greeter.lua
