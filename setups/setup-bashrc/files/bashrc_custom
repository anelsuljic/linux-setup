# Prints the dgpu status. Turned on = D0. Turned off = D3cold.
dgpu() 
{
    local d=/sys/bus/pci/devices/0000:01:00.0
    printf 'dGPU: power=%s runtime=%s control=%s\n' \
        "$(<"$d/power_state")" "$(<"$d/power/runtime_status")" "$(<"$d/power/control")"
}

# Prints what has the dgpu open, root processes included.
dgpu-users()
{
    sudo fuser -v /dev/nvidia* /dev/dri/by-path/pci-0000:01:00.0-*
}

# Virtualization
